<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="STSP.Pages.NouveauClient"
             Title="Créer un nouveau client">

    <VerticalStackLayout>
        <Label Text="Informations du client" Style="{StaticResource SectionHead}" />
        <Label Text="Nom" Style="{StaticResource ControlHead}" />
        <Entry x:Name="txtNom" />
        <Label Text="Prénom" Style="{StaticResource ControlHead}" />
        <Entry x:Name="txtPrenom" />
        <Label Text="Adresse" Style="{StaticResource ControlHead}" />
        <Entry x:Name="txtAdresse" />
        <Label Text="#Téléphone" Style="{StaticResource ControlHead}" />
        <Entry x:Name="txtTelephone" Keyboard="Telephone" />
        <Button x:Name="btnEnregistrer" Text="Enregistrer" Clicked="btnEnregistrer_Clicked" />
    </VerticalStackLayout>

</ContentPage>