<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="STSP.Pages.Login"
             Title="Login"
             NavigationPage.HasNavigationBar="False">
    
    <VerticalStackLayout Style="{StaticResource Login}">
        <BoxView HeightRequest="150" WidthRequest="150" Background="LightGray" />
        <Entry Placeholder="Nom utilisateur" x:Name="txtNomUtilisateur"></Entry>
        <Entry Placeholder="Mot de passe" x:Name="txtMotDePasse" IsPassword="True"></Entry>
        <Button Text="Se connecter" x:Name="btnSeConnecter" Clicked="btnSeConnecter_Clicked" />
        <Button Text="Créer un compte" x:Name="btnNouveauCompte" Clicked="btnNouveauCompte_Clicked" Style="{StaticResource Lien}" />
    </VerticalStackLayout>

</ContentPage>